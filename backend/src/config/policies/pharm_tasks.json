  "pregnancy_flags": {
    "X": ["valproate"],
    "D": ["paroxetine"],
    "high_risk": ["valproate", "paroxetine", "lithium"]
  },

  "controlled_substances": {
    "schedule_ii": ["methylphenidate", "amphetamine", "dextroamphetamine"],
    "schedule_iv": ["clonazepam", "lorazepam", "alprazolam", "zolpidem"]
  },

  "task_generation_rules": {
    "lab_task": {
      "create_on": "med_order_placed",
      "label_template": "Get {lab_name} blood test",
      "due_calculation": "order_date + {due_days} days",
      "points": 50
    },
    "symptom_watch": {
      "create_on": "med_order_placed",
      "label_template": "Watch for {symptom} - report {action}",
      "due_calculation": "order_date + 7 days",
      "points": 25
    },
    "education_review": {
      "create_on": "med_order_placed",
      "label_template": "Review {medication} safety information",
      "due_calculation": "order_date + 1 day",
      "points": 10
    }
  },

  "disclaimers": [
    "This is clinical decision support - not a replacement for clinical judgment",
    "Provider must review all tasks before patient assignment",
    "Lab requirements may vary based on patient history",
    "Always check drug interactions and contraindications",
    "Follow institutional protocols and guidelines"
  ]
}
