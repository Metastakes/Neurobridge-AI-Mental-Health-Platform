      "watch_symptoms": [
        { "symptom": "tremor", "severity": "moderate", "action": "report_immediately" },
        { "symptom": "polyuria", "severity": "moderate", "action": "report_within_24h" },
        { "symptom": "polydipsia", "severity": "moderate", "action": "report_within_24h" },
