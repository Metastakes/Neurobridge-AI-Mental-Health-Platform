        { "code": "BMP", "name": "Basic Metabolic Panel", "due_days": 7, "points": 50 },
        { "code": "TSH", "name": "Thyroid Function", "due_days": 30, "points": 50 },
        { "code": "LITHIUM_LEVEL", "name": "Lithium Level", "due_days": 7, "points": 50 }
