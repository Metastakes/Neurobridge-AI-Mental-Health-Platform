        { "symptom": "confusion", "severity": "high", "action": "emergency" },
        { "symptom": "muscle_weakness", "severity": "high", "action": "emergency" }
      ],
      "education": [
        "Stay well hydrated (8+ glasses water daily)",
        "Report tremors or confusion immediately",
        "Regular blood tests are required for safety",
        "Avoid NSAIDs (ibuprofen, naproxen) without provider approval"
      ]
    },

